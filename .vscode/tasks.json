{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Albek: Dev-Server starten",
      "type": "process",
      "command": "pnpm.cmd",
      "args": ["dev"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "albek-vite",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "endsPattern": "Local:"
        }
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}
